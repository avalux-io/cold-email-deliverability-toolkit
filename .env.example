# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/deliverability
REDIS_URL=redis://localhost:6379/0

# SendGrid Configuration
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_WEBHOOK_SECRET=your_webhook_secret_here

# Mailgun Configuration
MAILGUN_API_KEY=your_mailgun_api_key_here
MAILGUN_DOMAIN=your_mailgun_domain_here
MAILGUN_WEBHOOK_SECRET=your_webhook_secret_here

# Postmark Configuration
POSTMARK_API_KEY=your_postmark_api_key_here
POSTMARK_WEBHOOK_SECRET=your_webhook_secret_here

# Reputation Monitoring
SENDER_SCORE_API_KEY=your_sender_score_api_key_here
BARRACUDA_API_KEY=your_barracuda_api_key_here

# Compliance Settings
DEFAULT_COMPANY_NAME=Your Company Name
DEFAULT_PHYSICAL_ADDRESS=123 Main St, City, State, ZIP
DEFAULT_CONTACT_EMAIL=compliance@yourcompany.com
DEFAULT_JURISDICTION=canada  # Options: canada, usa, eu

# Warmup Configuration
DEFAULT_WARMUP_SCHEDULE=conservative  # Options: conservative, moderate, aggressive
MAX_DAILY_VOLUME=1000
MAX_HOURLY_VOLUME=50

# Monitoring Thresholds
BOUNCE_RATE_THRESHOLD=0.03  # 3%
SPAM_COMPLAINT_THRESHOLD=0.001  # 0.1%
REPUTATION_SCORE_THRESHOLD=80

# Alert Configuration
ALERT_EMAIL=alerts@yourcompany.com
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Application Settings
ENVIRONMENT=development  # Options: development, staging, production
DEBUG=true
LOG_LEVEL=INFO